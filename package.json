{
  "name": "trading-bot",
  "version": "1.0.8",
  "description": "Automated trading bot with MT5 bridge, backtesting engine and strategy modules",
  "main": "dist/index.js",
  "author": "Dev",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "backtest": "ts-node src/backtester/backtest-runner.ts",
    "replay:m5": "ts-node src/backtester/m5-replay.ts",
    "replay:strategy": "ts-node src/backtester/strategy-replay.ts",
    "replay:strategy:live": "ts-node src/backtester/strategy-replay-live.ts",
    "replay:entryTiming": "ts-node src/backtester/entry-timing-replay.ts",
    "sweep:entryTiming": "ts-node src/backtester/param-sweep-entry-timing.ts",
    "sample:candidates": "ts-node src/backtester/sample-candidates.ts",
    "tuned:test:gbpusd": "ts-node src/backtester/tuned-test-gbpusd.ts",
    "train": "python ./scripts/train_model.py --input ./data/output/trade_signals.jsonl --output ./data/output/model.pkl",
    "scorer": "python ./scripts/scorer_server.py --model ./data/output/model.pkl --port 5100",
    "test:scorer": "python ./scripts/test_model_load.py --model ./data/output/model.pkl",
    "mode-check": "python ./scripts/switch_mode.py --status",
    "mode-switch": "python ./scripts/switch_mode.py --mode"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "mathjs": "^12.2.0",
    "node-cron": "^3.0.0",
    "ws": "^8.14.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "@types/express": "^4.17.21",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "eslint": "^8.53.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.4.0",
    "eslint-plugin-promise": "^6.1.1"
  }
}
