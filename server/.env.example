// frontend/server/.env.example
// Copy this to .env and fill in your values

// IMPORTANT: If your password contains special characters like # @ : / etc,
// URL-encode them! Example: # becomes %23, @ becomes %40
// Use this site to encode: https://www.urlencoder.org/

// MongoDB connection string (use double quotes to prevent comment issues)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp"
MONGODB_DB=tradebot

# Server port
PORT=3001

# Optional: MT5 Bridge URL (if different from default)
MT5_BRIDGE=http://163.5.210.176:5000
